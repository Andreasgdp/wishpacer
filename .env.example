# ==============================================================================
# WishPacer Environment Configuration
# Copy to .env.local (or manage via Doppler) for local development / self-hosting
# ==============================================================================

# --- Database (Local SQLite by default, or Turso LibSQL in production) ---
DATABASE_URL="file:./data/saving_plan.db"
# TURSO_DATABASE_URL="libsql://your-db-org.turso.io"
# TURSO_AUTH_TOKEN=""

# --- Authentication (Clerk — optional for local-only mode) ---
VITE_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# --- Billing & Hosted Cloud Sync Paywall (Polar.sh) ---
# Self-hosters: leave both set to "false" (default) to run with billing disabled.
ENABLE_BILLING="false"
VITE_ENABLE_BILLING="false"

# Polar.sh credentials (only required when ENABLE_BILLING=true)
# POLAR_ACCESS_TOKEN=""
# POLAR_WEBHOOK_SECRET=""
# VITE_POLAR_CHECKOUT_URL=""

# --- Legacy Dev Activation Gate (temporary, removed once Polar billing launches) ---
# VITE_DEV_ACTIVATION_CODE="SAVINGS2026"
